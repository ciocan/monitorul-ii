# Proxy URL routed through for monitoruloficial.ro requests.
# Format: http[s]://user:password@host:port
# Leave empty (or pass --no-proxy on the CLI) to hit the site directly.
PROXY_URL=

# S3-compatible bucket for mirroring downloaded PDFs (Cloudflare R2 works as-is).
# Endpoint for R2 looks like: https://<account-id>.r2.cloudflarestorage.com
# Leave any of these unset (or pass --no-upload) to skip the S3 mirror.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=monitorul-ii
