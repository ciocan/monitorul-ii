{
  "index_patterns": ["mo-speeches-*"],
  "composed_of": ["mo-analyzers", "mo-common-fields"],
  "template": {
    "mappings": {
      "properties": {
        "chamber":              { "type": "keyword" },
        "session_date":         { "type": "date" },
        "session_type":         { "type": "keyword" },
        "legislature":          { "type": "keyword" },
        "year":                 { "type": "short" },
        "mo_issue":             { "type": "keyword" },
        "agenda_ordinal":       { "type": "short" },
        "agenda_title": {
          "type": "text",
          "analyzer": "romanian",
          "fields": {
            "keyword": { "type": "keyword", "ignore_above": 512 },
            "folded":  { "type": "text", "analyzer": "romanian_folded" }
          }
        },
        "agenda_category":      { "type": "keyword" },
        "agenda_outcome":       { "type": "keyword" },
        "speaker": {
          "properties": {
            "person_id":        { "type": "keyword" },
            "name_raw":         { "type": "keyword" },
            "name_search": {
              "type": "text",
              "analyzer": "romanian",
              "fields": {
                "keyword": { "type": "keyword" },
                "folded":  { "type": "text", "analyzer": "romanian_folded" }
              }
            },
            "title":            { "type": "keyword" },
            "role":             { "type": "keyword" },
            "party_group_at_time": { "type": "keyword" },
            "delivery_mode":    { "type": "keyword" }
          }
        },
        "text": {
          "type": "text",
          "analyzer": "romanian",
          "fields": {
            "exact":  { "type": "text", "analyzer": "romanian_exact" },
            "folded": { "type": "text", "analyzer": "romanian_folded" }
          }
        },
        "text_length":          { "type": "integer" },
        "is_substantive":       { "type": "boolean" },
        "position_in_agenda":   { "type": "integer" },
        "position_in_document": { "type": "integer" },
        "refs": {
          "properties": {
            "types":            { "type": "keyword" },
            "bills":            { "type": "keyword" },
            "laws":             { "type": "keyword" },
            "codes":            { "type": "keyword" },
            "ougs":             { "type": "keyword" },
            "ogs":              { "type": "keyword" },
            "raw":              { "type": "keyword" }
          }
        },
        "enrichments": {
          "properties": {
            "topics":           { "type": "keyword" },
            "summary":          { "type": "text", "analyzer": "romanian" },
            "embedding": {
              "type": "dense_vector",
              "dims": 1024,
              "index": true,
              "similarity": "cosine"
            },
            "embedding_text_fingerprint": { "type": "keyword" },
            "discourse": {
              "properties": {
                "hawkins": {
                  "properties": {
                    "score":                 { "type": "byte" },
                    "framework_confidence":  { "type": "float" },
                    "marker_count":          { "type": "byte" },
                    "marker_kinds":          { "type": "keyword" }
                  }
                },
                "voice": {
                  "properties": {
                    "dominant_voice":        { "type": "keyword" },
                    "voices_seen":           { "type": "keyword" }
                  }
                },
                "dqi": {
                  "properties": {
                    "level_of_justification":     { "type": "byte" },
                    "content_of_justification":   { "type": "keyword" },
                    "respect_for_groups":         { "type": "byte" },
                    "respect_for_demands":        { "type": "byte" },
                    "respect_for_counterarguments": { "type": "byte" },
                    "constructive_politics":      { "type": "keyword" }
                  }
                },
                "vparty": {
                  "properties": {
                    "score":                 { "type": "byte" },
                    "framework_confidence":  { "type": "float" },
                    "marker_count":          { "type": "byte" },
                    "marker_kinds":          { "type": "keyword" }
                  }
                }
              }
            },
            "discourse_producer":         { "type": "keyword" },
            "discourse_text_fingerprint": { "type": "keyword" }
          }
        },
        "slug":                 { "type": "keyword" },
        "url_path":             { "type": "keyword" }
      }
    }
  }
}
