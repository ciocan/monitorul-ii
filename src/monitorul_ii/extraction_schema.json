{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ciocan/monitorul-ii/blob/main/src/monitorul_ii/extraction_schema.json",
  "title": "Monitorul Oficial Partea II extraction sidecar",
  "description": "Canonical machine-readable schema for the per-document JSON sidecars emitted by `monitorul-ii extract`. Mirrors docs/extraction-schema.md (the human-readable spec). Schema_version 1.7.0 graduates committee_synthesis from PendingBody to a strict body shape (period + per-committee meetings with roster/agenda/joint_with). report_facsimile remains PendingBody until its extractor lands.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "content_sha",
    "document_type",
    "metadata",
    "raw_markdown_path",
    "raw_pdf_path",
    "extraction",
    "coverage",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.7.0" },
    "document_id": {
      "type": "string",
      "pattern": "^mo://\\d{4}/[IVXM]+/[0-9A-Za-z]+$"
    },
    "content_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "document_type": { "$ref": "#/$defs/DocumentType" },
    "metadata": { "$ref": "#/$defs/Metadata" },
    "raw_markdown_path": { "type": "string", "minLength": 1 },
    "raw_pdf_path": { "type": "string", "minLength": 1 },
    "extraction": { "$ref": "#/$defs/Extraction" },
    "coverage": { "$ref": "#/$defs/Coverage" },
    "body": true
  },
  "oneOf": [
    {
      "properties": {
        "document_type": { "const": "question_register" },
        "body": { "$ref": "#/$defs/QuestionRegisterBody" }
      }
    },
    {
      "properties": {
        "document_type": { "const": "other" },
        "body": { "$ref": "#/$defs/OtherBody" }
      }
    },
    {
      "properties": {
        "document_type": { "const": "plenary_stenogram" },
        "body": { "$ref": "#/$defs/PlenaryStenogramBody" }
      }
    },
    {
      "properties": {
        "document_type": { "const": "plenary_joint_session" },
        "body": { "$ref": "#/$defs/PlenaryJointSessionBody" }
      }
    },
    {
      "properties": {
        "document_type": { "const": "committee_synthesis" },
        "body": { "$ref": "#/$defs/CommitteeSynthesisBody" }
      }
    },
    {
      "properties": {
        "document_type": { "const": "report_facsimile" },
        "body": { "$ref": "#/$defs/PendingBody" }
      }
    }
  ],
  "$defs": {
    "DocumentType": {
      "enum": [
        "plenary_stenogram",
        "plenary_joint_session",
        "committee_synthesis",
        "report_facsimile",
        "question_register",
        "other"
      ]
    },
    "Metadata": {
      "type": "object",
      "required": ["issue", "year", "part", "published"],
      "additionalProperties": false,
      "properties": {
        "issue": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "part": { "type": "string", "pattern": "^[IVXM]+$" },
        "published": { "type": "string", "format": "date" },
        "chamber": {
          "anyOf": [
            { "enum": ["Camera Deputaților", "Senatul", "joint"] },
            { "type": "null" }
          ]
        },
        "session": { "type": ["string", "null"] },
        "session_type": {
          "anyOf": [
            { "enum": ["ordinary", "extraordinary"] },
            { "type": "null" }
          ]
        },
        "session_date": {
          "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        },
        "legislature": { "type": ["string", "null"] }
      }
    },
    "Extraction": {
      "type": "object",
      "required": ["extractor", "extracted_at", "extractor_versions", "confidence"],
      "additionalProperties": false,
      "properties": {
        "extractor": { "type": "string", "minLength": 1 },
        "extracted_at": { "type": "string", "format": "date-time" },
        "extractor_versions": {
          "type": "object",
          "description": "Per-component versions: one key per shared helper (boilerplate, references, speakers, coverage, topics) plus one per per-type extractor (question_register, plenary_stenogram, plenary_joint_session, ...). Bumping any key invalidates sidecars whose body depends on that component.",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "anyOf": [
                { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Coverage": {
      "type": "object",
      "description": "Diagnostic block: how much of the body did the extractor account for, and what's left unclaimed? Never gates writes; surfaces what the next extractor version needs to cover.",
      "required": ["body_chars", "claimed_chars", "claimed_pct", "gaps", "claimed_by_policy"],
      "additionalProperties": false,
      "properties": {
        "body_chars": { "type": "integer", "minimum": 0 },
        "claimed_chars": { "type": "integer", "minimum": 0 },
        "claimed_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/CoverageGap" }
        },
        "claimed_by_policy": {
          "type": "array",
          "items": { "$ref": "#/$defs/ClaimByPolicy" }
        }
      }
    },
    "CoverageGap": {
      "type": "object",
      "required": ["chars", "lines", "preview"],
      "additionalProperties": false,
      "properties": {
        "chars": { "$ref": "#/$defs/CharRange" },
        "lines": { "$ref": "#/$defs/LineRange" },
        "preview": { "type": "string" }
      }
    },
    "ClaimByPolicy": {
      "type": "object",
      "required": ["chars", "lines", "reason"],
      "additionalProperties": false,
      "properties": {
        "chars": { "$ref": "#/$defs/CharRange" },
        "lines": { "$ref": "#/$defs/LineRange" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "CharRange": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "LineRange": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "ContentSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "SourceSpan": {
      "type": "object",
      "required": ["chars", "lines", "content_sha"],
      "additionalProperties": false,
      "properties": {
        "chars": { "$ref": "#/$defs/CharRange" },
        "lines": { "$ref": "#/$defs/LineRange" },
        "content_sha": { "$ref": "#/$defs/ContentSha" }
      }
    },
    "PerSectionExtraction": {
      "type": "object",
      "required": ["extractor", "confidence", "source_span"],
      "additionalProperties": false,
      "properties": {
        "extractor": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_span": { "$ref": "#/$defs/SourceSpan" }
      }
    },
    "Speaker": {
      "type": "object",
      "required": ["raw", "name", "title", "role", "party_group", "person_id"],
      "additionalProperties": false,
      "properties": {
        "raw": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "party_group": { "type": ["string", "null"] },
        "person_id": { "type": ["string", "null"] }
      }
    },
    "QuestionRegisterBody": {
      "type": "object",
      "required": ["session_label", "chamber", "questions"],
      "additionalProperties": false,
      "properties": {
        "session_label": { "type": ["string", "null"] },
        "chamber": {
          "anyOf": [
            { "enum": ["Camera Deputaților", "Senatul"] },
            { "type": "null" }
          ]
        },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Question" }
        }
      }
    },
    "Question": {
      "type": "object",
      "required": [
        "ordinal",
        "addressee",
        "questioner",
        "registration_number",
        "registration_date",
        "topic",
        "question_text",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "addressee": { "$ref": "#/$defs/QuestionAddressee" },
        "questioner": { "$ref": "#/$defs/Speaker" },
        "registration_number": { "type": ["string", "null"] },
        "registration_date": {
          "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        },
        "topic": { "type": ["string", "null"] },
        "question_text": { "type": ["string", "null"] },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "QuestionAddressee": {
      "type": "object",
      "description": "Recipient of a written question. The `ministry` field holds the institution name (typically a ministry, but also intelligence services, CNSAS, ombudsman, central bank, etc.); naming kept for schema-doc continuity.",
      "required": ["ministry", "ministry_normalized", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "ministry": { "type": ["string", "null"] },
        "ministry_normalized": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] }
      }
    },
    "OtherBody": {
      "type": "object",
      "required": ["headings", "raw_markdown_excerpt", "extraction"],
      "additionalProperties": false,
      "properties": {
        "headings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Heading" }
        },
        "raw_markdown_excerpt": { "type": "string" },
        "extraction": {
          "type": "object",
          "required": ["extractor", "confidence", "reason", "candidate_types"],
          "additionalProperties": false,
          "properties": {
            "extractor": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "reason": { "type": "string" },
            "candidate_types": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "score"],
                "additionalProperties": false,
                "properties": {
                  "type": { "$ref": "#/$defs/DocumentType" },
                  "score": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "Heading": {
      "type": "object",
      "required": ["level", "text", "line"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "PendingBody": {
      "type": "object",
      "description": "Placeholder for body shapes whose per-type extractor has not yet landed (currently: report_facsimile). Tightened to its full shape when its extractor ships. Until then, additionalProperties is true so the discriminator works without forcing a partial body shape now.",
      "additionalProperties": true
    },
    "CommitteeSynthesisBody": {
      "type": "object",
      "description": "Body shape for `committee_synthesis` documents — weekly synthesis of one or more parliamentary committees' work. v0.1 ships per-committee block partitioning (name, signatures, dates, agenda items with bill cites + outcome text). Fields like `purpose`, `vote_summary.counts`, `roster.intra_committee_role` are best-effort and frequently null in v0.1; tighter parsing graduates as discovery-loop coverage stabilises.",
      "required": ["period", "committees"],
      "additionalProperties": false,
      "properties": {
        "period": { "$ref": "#/$defs/CommitteePeriod" },
        "committees": {
          "type": "array",
          "items": { "$ref": "#/$defs/Committee" }
        }
      }
    },
    "CommitteePeriod": {
      "type": "object",
      "description": "Date range covered by the synthesis (e.g. 'Perioada: 2-5.06.2025'). Both endpoints inclusive; equal when the synthesis covers a single day.",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        },
        "end": {
          "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        }
      }
    },
    "Committee": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "chair",
        "secretary",
        "meetings",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "permanent",
                "special",
                "inquiry",
                "special_joint",
                "inquiry_joint"
              ]
            },
            { "type": "null" }
          ]
        },
        "chair": {
          "anyOf": [{ "$ref": "#/$defs/Speaker" }, { "type": "null" }]
        },
        "secretary": {
          "anyOf": [{ "$ref": "#/$defs/Speaker" }, { "type": "null" }]
        },
        "meetings": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommitteeMeeting" }
        },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "CommitteeMeeting": {
      "type": "object",
      "description": "v0.1 emits one meeting per committee block — the synthesis groups multi-day work as one narrative. Per-day splits are deferred to v0.2 when per-day rosters genuinely diverge.",
      "required": [
        "dates",
        "time_windows",
        "format",
        "purpose",
        "joint_with",
        "roster",
        "agenda",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "dates": {
          "type": "array",
          "items": { "type": "string", "format": "date" }
        },
        "time_windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/TimeWindow" }
        },
        "format": {
          "anyOf": [
            { "enum": ["in_person", "online", "mixed"] },
            { "type": "null" }
          ]
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "documentare_consultare",
                "dezbatere_decizie",
                "aprobare_raport",
                "audiere_candidați"
              ]
            },
            { "type": "null" }
          ]
        },
        "joint_with": {
          "type": "array",
          "items": { "$ref": "#/$defs/JointCommittee" }
        },
        "roster": {
          "type": "array",
          "items": { "$ref": "#/$defs/RosterEntry" }
        },
        "agenda": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommitteeAgendaItem" }
        },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "TimeWindow": {
      "type": "object",
      "description": "Single contiguous interval; multi-window meetings emit multiple entries. Format strings preserve the source layout (e.g. '15.00' or '15:00') — normalisation happens downstream when needed.",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      }
    },
    "JointCommittee": {
      "type": "object",
      "required": ["name", "chamber"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "chamber": {
          "anyOf": [{ "enum": ["camera", "senat"] }, { "type": "null" }]
        }
      }
    },
    "RosterEntry": {
      "type": "object",
      "description": "One committee member's per-meeting attendance state. `mode` defaults to `physical` for pre-pandemic synthesis where no per-attendee marker exists; explicit 'Prezent fizic'/'Prezent online'/'Absent' annotations override.",
      "required": ["speaker", "mode", "intra_committee_role", "substituted_by"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "$ref": "#/$defs/Speaker" },
        "mode": {
          "enum": ["physical", "online", "absent", "substituted"]
        },
        "intra_committee_role": {
          "anyOf": [
            { "enum": ["președinte", "vicepreședinte", "secretar", "membru"] },
            { "type": "null" }
          ]
        },
        "substituted_by": {
          "anyOf": [{ "$ref": "#/$defs/Speaker" }, { "type": "null" }]
        }
      }
    },
    "CommitteeVoteSummary": {
      "type": "object",
      "description": "Lean vote summary for committee work — outcomes are typically reported narratively ('aprobat cu majoritate de voturi (6 împotrivă, 2 abțineri)'). Counts are best-effort integers extracted from the parenthetical.",
      "required": [
        "outcome",
        "majority",
        "for",
        "against",
        "abstain",
        "amendments_passed"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "anyOf": [
            { "enum": ["approved", "rejected", "deferred"] },
            { "type": "null" }
          ]
        },
        "majority": {
          "anyOf": [
            { "enum": ["majority", "unanimous", "tied"] },
            { "type": "null" }
          ]
        },
        "for": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "against": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "abstain": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "amendments_passed": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "CommitteeAgendaItem": {
      "type": "object",
      "description": "One bill / proposal / EU document the committee considered. v0.1 surfaces ordinal, title, primary_references (bill/law/OUG/etc.), committee_role (fond / aviz / fond_comun), output_type (raport / aviz / amânare / …), and a narrative outcome_text. Structured vote_summary remains best-effort and is null when the synthesis doesn't include a tally.",
      "required": [
        "ordinal",
        "title",
        "primary_references",
        "co_committees",
        "committee_role",
        "output_type",
        "for_committees",
        "outcome_text",
        "vote_summary",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "primary_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reference" }
        },
        "co_committees": {
          "type": "array",
          "items": { "type": "string" }
        },
        "committee_role": {
          "anyOf": [
            { "enum": ["fond", "aviz", "fond_comun"] },
            { "type": "null" }
          ]
        },
        "output_type": {
          "anyOf": [
            {
              "enum": [
                "raport",
                "raport_preliminar",
                "raport_suplimentar",
                "raport_comun",
                "raport_comun_suplimentar",
                "aviz",
                "studiu",
                "proiect_de_opinie",
                "amânare"
              ]
            },
            { "type": "null" }
          ]
        },
        "for_committees": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outcome_text": { "type": ["string", "null"] },
        "vote_summary": {
          "anyOf": [{ "$ref": "#/$defs/CommitteeVoteSummary" }, { "type": "null" }]
        },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "Reference": {
      "description": "Discriminated union of reference shapes. Universal fields on every variant: type, raw, char_offsets. v1.6.0 ships 6 strict variants (bill, law, oug, og, chamber_resolution, parliamentary_resolution) plus an `unknown` catch-all for spans that look reference-shaped but don't classify into the strict types. Variants 7-12 from the schema doc (motion, court_decision, constitution, regulation, eu_doc, treaty) graduate as the discovery loop surfaces query needs.",
      "oneOf": [
        { "$ref": "#/$defs/BillReference" },
        { "$ref": "#/$defs/LawReference" },
        { "$ref": "#/$defs/OugReference" },
        { "$ref": "#/$defs/OgReference" },
        { "$ref": "#/$defs/ChamberResolutionReference" },
        { "$ref": "#/$defs/ParliamentaryResolutionReference" },
        { "$ref": "#/$defs/UnknownReference" }
      ]
    },
    "BillReference": {
      "type": "object",
      "required": ["type", "raw", "char_offsets", "prefix", "number", "year"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "bill" },
        "raw": { "type": "string", "minLength": 1 },
        "char_offsets": { "$ref": "#/$defs/CharRange" },
        "prefix": { "enum": ["Pl-x", "PL-x", "L"] },
        "number": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "secondary_year": {
          "anyOf": [
            { "type": "integer", "minimum": 1990, "maximum": 2100 },
            { "type": "null" }
          ]
        },
        "chamber_of_origin": {
          "anyOf": [{ "enum": ["camera", "senat"] }, { "type": "null" }]
        },
        "procedure": { "type": ["string", "null"] }
      }
    },
    "LawReference": {
      "type": "object",
      "required": ["type", "raw", "char_offsets", "number", "year"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "law" },
        "raw": { "type": "string", "minLength": 1 },
        "char_offsets": { "$ref": "#/$defs/CharRange" },
        "number": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "subject": { "type": ["string", "null"] }
      }
    },
    "OugReference": {
      "type": "object",
      "required": ["type", "raw", "char_offsets", "number", "year"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "oug" },
        "raw": { "type": "string", "minLength": 1 },
        "char_offsets": { "$ref": "#/$defs/CharRange" },
        "number": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "issuer": { "type": ["string", "null"] }
      }
    },
    "OgReference": {
      "type": "object",
      "required": ["type", "raw", "char_offsets", "number", "year"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "og" },
        "raw": { "type": "string", "minLength": 1 },
        "char_offsets": { "$ref": "#/$defs/CharRange" },
        "number": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "issuer": { "type": ["string", "null"] }
      }
    },
    "ChamberResolutionReference": {
      "type": "object",
      "required": ["type", "raw", "char_offsets", "prefix", "number", "year"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chamber_resolution" },
        "raw": { "type": "string", "minLength": 1 },
        "char_offsets": { "$ref": "#/$defs/CharRange" },
        "prefix": { "enum": ["PHCD", "PHS", "PHCDS"] },
        "number": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "chamber": {
          "anyOf": [{ "enum": ["camera", "senat"] }, { "type": "null" }]
        }
      }
    },
    "ParliamentaryResolutionReference": {
      "type": "object",
      "description": "Hotărâre a Parlamentului României (HP) — joint Camera+Senat resolution.",
      "required": ["type", "raw", "char_offsets", "number", "year"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "parliamentary_resolution" },
        "raw": { "type": "string", "minLength": 1 },
        "char_offsets": { "$ref": "#/$defs/CharRange" },
        "number": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "subject": { "type": ["string", "null"] }
      }
    },
    "UnknownReference": {
      "type": "object",
      "description": "Catch-all for spans that look reference-shaped but don't classify into the 6 strict variants. The `hint` field carries a coarse classifier output (law-ish, court-ish, eu-doc-ish, other) that future extractor versions use to graduate variants.",
      "required": ["type", "raw", "char_offsets", "hint"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "unknown" },
        "raw": { "type": "string", "minLength": 1 },
        "char_offsets": { "$ref": "#/$defs/CharRange" },
        "hint": {
          "anyOf": [
            { "enum": ["law-ish", "court-ish", "eu-doc-ish", "other"] },
            { "type": "null" }
          ]
        }
      }
    },
    "VoteCounts": {
      "type": "object",
      "required": ["for", "against", "abstain", "not_voting", "total_voting"],
      "additionalProperties": false,
      "properties": {
        "for": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "const": "unanimous" },
            { "type": "null" }
          ]
        },
        "against": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "abstain": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "not_voting": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "total_voting": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "Topics": {
      "type": "object",
      "required": ["primary", "secondary"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "enum": [
              "Educație",
              "Sănătate",
              "Apărare",
              "Economie",
              "Transporturi",
              "Afaceri europene",
              "Justiție",
              "Muncă",
              "Agricultură",
              "Mediu",
              "Cultură",
              "Buget-finanțe",
              "Administrație",
              "Politică externă",
              "Drepturile omului"
            ]
          }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Attendance": {
      "type": "object",
      "required": ["registered", "total_seats"],
      "additionalProperties": false,
      "properties": {
        "registered": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "total_seats": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "ChairSegment": {
      "type": "object",
      "required": ["chair", "secretaries", "segment_label", "started_at"],
      "additionalProperties": false,
      "properties": {
        "chair": { "$ref": "#/$defs/Speaker" },
        "secretaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/Speaker" }
        },
        "segment_label": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] }
      }
    },
    "PlenarySession": {
      "type": "object",
      "required": [
        "chair",
        "chair_segments",
        "secretaries",
        "attendance",
        "quorum_met",
        "opened_at",
        "closed_at",
        "format",
        "outcome",
        "special_procedure"
      ],
      "additionalProperties": false,
      "properties": {
        "chair": {
          "type": "array",
          "items": { "$ref": "#/$defs/Speaker" }
        },
        "chair_segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChairSegment" }
        },
        "secretaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/Speaker" }
        },
        "attendance": { "$ref": "#/$defs/Attendance" },
        "quorum_met": { "type": ["boolean", "null"] },
        "opened_at": { "type": ["string", "null"] },
        "closed_at": { "type": ["string", "null"] },
        "format": {
          "anyOf": [
            { "enum": ["in_person", "online", "mixed"] },
            { "type": "null" }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "suspended_no_quorum",
                "suspended_other",
                "adjourned"
              ]
            },
            { "type": "null" }
          ]
        },
        "special_procedure": {
          "anyOf": [
            {
              "enum": [
                "buget_de_stat",
                "declaratie_solemna",
                "mesaj_prezidential",
                "sedinta_solemna",
                "deschiderea_legislaturii",
                "deschiderea_sesiunii"
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "PlenaryJointSession": {
      "type": "object",
      "required": [
        "chair",
        "chair_segments",
        "chambers_present",
        "secretaries",
        "attendance",
        "quorum_met",
        "opened_at",
        "closed_at",
        "format",
        "outcome",
        "special_procedure"
      ],
      "additionalProperties": false,
      "properties": {
        "chair": {
          "type": "array",
          "items": { "$ref": "#/$defs/Speaker" }
        },
        "chair_segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChairSegment" }
        },
        "chambers_present": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secretaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/Speaker" }
        },
        "attendance": { "$ref": "#/$defs/Attendance" },
        "quorum_met": { "type": ["boolean", "null"] },
        "opened_at": { "type": ["string", "null"] },
        "closed_at": { "type": ["string", "null"] },
        "format": {
          "anyOf": [
            { "enum": ["in_person", "online", "mixed"] },
            { "type": "null" }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "suspended_no_quorum",
                "suspended_other",
                "adjourned"
              ]
            },
            { "type": "null" }
          ]
        },
        "special_procedure": {
          "anyOf": [
            {
              "enum": [
                "buget_de_stat",
                "declaratie_solemna",
                "mesaj_prezidential",
                "sedinta_solemna",
                "deschiderea_legislaturii",
                "deschiderea_sesiunii"
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "Activity": {
      "description": "Discriminated union of agenda-item activities. Each variant carries its own type-specific fields plus the universal source_span + extraction provenance.",
      "oneOf": [
        { "$ref": "#/$defs/SpeechActivity" },
        { "$ref": "#/$defs/VoteActivity" },
        { "$ref": "#/$defs/ProceduralActivity" },
        { "$ref": "#/$defs/NarratorActivity" },
        { "$ref": "#/$defs/DeferralActivity" }
      ]
    },
    "SpeechActivity": {
      "type": "object",
      "required": [
        "type",
        "speaker",
        "delivery_mode",
        "text",
        "references_mentioned",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "speech" },
        "speaker": { "$ref": "#/$defs/Speaker" },
        "delivery_mode": {
          "anyOf": [
            {
              "enum": ["tribune", "from_floor", "written", "online", "from_balcony"]
            },
            { "type": "null" }
          ]
        },
        "text": { "type": "string" },
        "references_mentioned": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reference" }
        },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "VoteActivity": {
      "type": "object",
      "required": [
        "type",
        "motion_text",
        "motion_type",
        "voting_method",
        "timing",
        "counts",
        "outcome",
        "quorum_announced",
        "proposed_by",
        "nominal_breakdown",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "vote" },
        "motion_text": { "type": "string" },
        "motion_type": {
          "enum": [
            "procedural",
            "amendment",
            "final",
            "item_adoption",
            "agenda_approval",
            "urgency_procedure",
            "report_approval",
            "system_check"
          ]
        },
        "voting_method": {
          "anyOf": [
            {
              "enum": [
                "electronic",
                "electronic_remote",
                "show_of_hands",
                "secret_ballot",
                "nominal",
                "telephone_roll_call",
                "by_acclamation"
              ]
            },
            { "type": "null" }
          ]
        },
        "timing": { "enum": ["live", "deferred"] },
        "counts": { "$ref": "#/$defs/VoteCounts" },
        "outcome": {
          "enum": ["approved", "rejected", "tied", "deferred", "no_quorum"]
        },
        "quorum_announced": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "proposed_by": {
          "anyOf": [{ "$ref": "#/$defs/Speaker" }, { "type": "null" }]
        },
        "nominal_breakdown": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["person_id", "vote"],
                "additionalProperties": false,
                "properties": {
                  "person_id": { "type": "string" },
                  "vote": { "enum": ["for", "against", "abstain", "absent"] }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "ProceduralActivity": {
      "type": "object",
      "required": ["type", "actor", "text", "source_span", "extraction"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "procedural" },
        "actor": {
          "anyOf": [{ "$ref": "#/$defs/Speaker" }, { "type": "null" }]
        },
        "text": { "type": "string" },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "NarratorActivity": {
      "type": "object",
      "required": ["type", "text", "source_span", "extraction"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "narrator" },
        "text": { "type": "string" },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "DeferralActivity": {
      "type": "object",
      "required": ["type", "text", "defers_to", "source_span", "extraction"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "deferral" },
        "text": { "type": "string" },
        "defers_to": { "type": ["string", "null"] },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "AgendaItem": {
      "type": "object",
      "required": [
        "ordinal",
        "title",
        "primary_references",
        "category",
        "confidence_type",
        "requested_by_group",
        "outcome",
        "reexamination_reason",
        "pages_in_pdf",
        "topics",
        "activities",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "primary_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reference" }
        },
        "category": {
          "enum": [
            "bill_debate",
            "political_declarations",
            "commemorative",
            "final_vote_batch",
            "procedural",
            "tacit_adoption",
            "appointment",
            "motion",
            "committee_report_presentation",
            "legislative_transmission",
            "withdrawal",
            "notification",
            "regulation_amendment",
            "party_membership_change",
            "subsidiarity_check",
            "foreign_address",
            "seat_vacancy",
            "parliamentary_declaration",
            "delegation_membership",
            "government_confidence",
            "government_hour",
            "oath_taking",
            "mandate_validation",
            "chamber_officer",
            "committee_membership",
            "eu_consultation",
            "questions_interpellations",
            "deadline_extension",
            "other"
          ]
        },
        "confidence_type": {
          "anyOf": [
            {
              "enum": [
                "investitură",
                "cenzură",
                "angajare_răspundere",
                "demitere"
              ]
            },
            { "type": "null" }
          ]
        },
        "requested_by_group": { "type": ["string", "null"] },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "adoptat",
                "respins",
                "adoptat_tacit",
                "retrimis",
                "retras",
                "votul_final_deferred",
                "vot_amânat",
                "informare",
                "tăcere_legislativă"
              ]
            },
            { "type": "null" }
          ]
        },
        "reexamination_reason": {
          "anyOf": [
            {
              "enum": [
                "presidential_request",
                "constitutional_court",
                "parliamentary_majority"
              ]
            },
            { "type": "null" }
          ]
        },
        "pages_in_pdf": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "topics": { "$ref": "#/$defs/Topics" },
        "activities": {
          "type": "array",
          "items": { "$ref": "#/$defs/Activity" }
        },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "InterpellationResponse": {
      "type": "object",
      "required": ["speaker", "text"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "$ref": "#/$defs/Speaker" },
        "text": { "type": "string" }
      }
    },
    "Interpellation": {
      "type": "object",
      "required": [
        "genre",
        "questioner",
        "addressed_to",
        "addressed_to_normalized",
        "interpellation_number",
        "topic",
        "question_text",
        "response",
        "response_deferred",
        "source_span",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "genre": { "enum": ["întrebare", "interpelare"] },
        "questioner": { "$ref": "#/$defs/Speaker" },
        "addressed_to": { "type": ["string", "null"] },
        "addressed_to_normalized": { "type": ["string", "null"] },
        "interpellation_number": { "type": ["string", "null"] },
        "topic": { "type": ["string", "null"] },
        "question_text": { "type": ["string", "null"] },
        "response": {
          "anyOf": [
            { "$ref": "#/$defs/InterpellationResponse" },
            { "type": "null" }
          ]
        },
        "response_deferred": { "type": "boolean" },
        "source_span": { "$ref": "#/$defs/SourceSpan" },
        "extraction": { "$ref": "#/$defs/PerSectionExtraction" }
      }
    },
    "PlenaryStenogramBody": {
      "type": "object",
      "required": ["session", "agenda_items", "interpellations"],
      "additionalProperties": false,
      "properties": {
        "session": { "$ref": "#/$defs/PlenarySession" },
        "agenda_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/AgendaItem" }
        },
        "interpellations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Interpellation" }
        }
      }
    },
    "PlenaryJointSessionBody": {
      "type": "object",
      "required": ["session", "agenda_items", "interpellations"],
      "additionalProperties": false,
      "properties": {
        "session": { "$ref": "#/$defs/PlenaryJointSession" },
        "agenda_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/AgendaItem" }
        },
        "interpellations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Interpellation" }
        }
      }
    }
  }
}
